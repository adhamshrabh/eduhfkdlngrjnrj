# انسخي هذا الملف إلى .env واملئيه. لا ترفعي .env إلى git إطلاقاً.
DJANGO_SECRET_KEY=غيّريه-إلى-قيمة-عشوائية-طويلة
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# للتطوير السريع بلا Postgres:
DATABASE_URL=sqlite:///db.sqlite3
# للإنتاج:
# DATABASE_URL=postgres://edu:كلمة-مرور@db:5432/edu

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
