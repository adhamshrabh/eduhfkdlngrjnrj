# بديلٌ لخادمٍ **بلا** منهٍ عكسي. الخادم الحالي فيه nginx وشهادة صالحة،
# فاستعملي `nginx-rawda.conf` بدله — Caddy هنا سينازعه المنفذين 80 و443.
#
# منهٍ عكسي بشهادة تلقائية — وهو ما يجعل قارئ البطاقات يعمل أصلاً.
#
# ⚠️ ليست الشهادة تجميلاً ولا «تشديداً أمنياً» مؤجَّلاً: واجهة Web Serial
# محجوبة في السياق غير الآمن. على http://<ip> يحذفها المتصفّح كلّياً،
# فيبدو الصندوق معطوباً وهو سليم. لا HTTPS = لا بطاقات.
#
# SITE_ADDRESS اسم النطاق. وبلا نطاق مشترى يكفي nip.io/sslip.io، وهو اسم
# عامّ حقيقي يُترجَم إلى عنوانك فتُصدَر له شهادة Let's Encrypt عادية:
#
#   SITE_ADDRESS=187.127.118.191.nip.io
#
# يشترط ذلك أن يكون المنفذان 80 و443 مفتوحين ومتاحين من الإنترنت — التحقّق
# يجري عبر 80. وفي شبكة مغلقة بلا منفذ عام، بدّلي السطر إلى:
#
#   {$SITE_ADDRESS} {
#       tls internal
#       ...
#
# وعندها تُثبَّت شهادة جذر Caddy على أجهزة المعلّمات مرّة واحدة، وإلا رأين
# تحذيراً في كل صباح.

{$SITE_ADDRESS} {
	encode zstd gzip

	# Caddy يضيف X-Forwarded-Proto، وهو ما يقرأه SECURE_PROXY_SSL_HEADER في
	# `config/settings/prod.py`. بلا هذا التطابق يرى Django طلباً بـ http
	# خلف https فيدور في إعادة توجيه لا تنتهي.
	reverse_proxy backend:8000
}
