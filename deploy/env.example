# إعدادات الإنتاج — انسخيه إلى `.env` في **جذر المستودع** على الخادم واملئيه:
#
#   cp deploy/env.example .env && chmod 600 .env
#
# ⚠️ `.env` خارج git (انظري .gitignore) والمستودع عامّ: لا يُرفع أبداً.
# وهو غير `backend/.env` الخاصّ بالتطوير على جهازك.

# سلسلة عشوائية طويلة، تُولَّد مرّة واحدة ولا تتغيّر (تغييرها يُخرج كل المعلّمات):
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# كلمة مرور قاعدة البيانات. تُضبط قبل أول تشغيل؛ تغييرها لاحقاً لا يغيّرها
# داخل Postgres القائم.
POSTGRES_PASSWORD=

# اسم النطاق كما في شهادة HTTPS. أول اسم هنا هو ما يستعمله فحص الصحّة.
DJANGO_ALLOWED_HOSTS=srv1714868.hstgr.cloud

# لا تكتبيه يدوياً: يضبطه deploy/deploy.sh بعد كل نشرٍ ناجح أو تراجع.
# RELEASE=
