# وضع التطوير فقط (npm run dev:studio). في الإنتاج رابط العودة النسبي
# (/stories) بملف index.html يكفي — أصل واحد خلف Django. بدون هذا
# المتغيّر بوضع التطوير، رابط العودة كان سينتقل لمسار غير موجود على
# خادم الاستوديو نفسه (منفذ 5174) بدل تطبيق الويب الحقيقي (منفذ 5173) —
# نفس عطل VITE_STUDIO_URL المعكوس، بالاتجاه الآخر.
VITE_APP_URL=http://localhost:5173/stories
